# Local build keys. Run `make setup` to create your own .env from this file,
# then fill in the values. .env is git-ignored; never commit real values.
#
# The app builds and runs without them; features that need a key show
# "not configured". Release builds get them from GitHub Actions secrets.
#
# Where to get them (Linear, project "VOD Helper v1"):
#   - Setup: Register the Twitch app
#   - Setup: Google Cloud project for YouTube uploads

# Twitch sign-in (public client, no secret). See README "Twitch sign-in".
TWITCH_CLIENT_ID=

# YouTube upload (Google desktop app sign-in key)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
